<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config for KalkanSigner helper.

  Critical: route ALL logging to STDERR. stdout is reserved for the
  line-based KalkanSigner protocol (OK/ERR/PONG). Without this, xmlsec/
  Kalkan DEBUG messages get mixed into stdout and the Python parent
  reads them instead of command responses.

  Level WARN suppresses xmlsec/CMS chatter; bump to DEBUG if you need
  to investigate signing errors.
-->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
