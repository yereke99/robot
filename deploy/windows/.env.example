# Goszakup bot environment variables on Windows.
# Copy this file to the repo root as `.env` and fill in real values.
# The bot reads it via python-dotenv at startup; nothing else looks at it.
#
# Do NOT commit `.env` (already in .gitignore).
# Lock down permissions: right-click .env -> Properties -> Security ->
# leave only your user account with Read/Write.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TG_BOT_TOKEN=1234567890:ABCDEFGH-IJKLMNOPQRSTUVWXYZ_abcdefghij

# ECP (.p12) password. Env name = GOSZAKUP_<SERVICE>_<ACCOUNT> upper-cased
# with non-alphanumerics replaced by underscores. Matches config.yaml's
# `ecp.password_keyring_service` / `ecp.password_keyring_user`.
GOSZAKUP_GOSZAKUP_ECP_DEFAULT=your-ecp-password

# Goszakup cabinet password (for auto-login + /login flows).
GOSZAKUP_GOSZAKUP_ACC_DEFAULT=your-cabinet-password

# Optional: pin Java if winget didn't add it to PATH.
# JAVA_BIN=C:\Program Files\Eclipse Adoptium\jdk-21.0.4.7-hotspot\bin\java.exe

# Optional: timezone (only matters for log timestamps).
TZ=Asia/Almaty

# Optional: test parallel downloading of large technical specifications when
# the portal advertises byte ranges and supplies a strong ETag.
# ATAGOS_SPEC_RANGE_DOWNLOAD=1
